# Required
DATABASE_URL=postgresql://user:pass@host:5432/throwdown
ADMIN_PASSWORD=change-me

# Public URL of the site (used in emails and Stripe redirects)
BASE_URL=https://throwdown.me

# Stripe — leave blank to run in demo mode (no cards, pledges recorded directly)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email via Resend — leave blank to skip sending
RESEND_API_KEY=
EMAIL_FROM=Throwdown <hello@throwdown.me>

# Optional
# MIN_TARGET_DOLLARS=5000
# DEADLINE_DAYS=75
