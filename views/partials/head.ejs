<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — crowdfunding for debates` %></title>
<meta name="description" content="<%= typeof description !== 'undefined' && description ? description : 'Put money behind the debate you want to see. When the number gets big enough, it happens.' %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23ff3b3b'/></svg>">
<meta property="og:site_name" content="<%= SITE_NAME %>">
<meta property="og:title" content="<%= title ? title : `${SITE_NAME} — crowdfunding for debates` %>">
<meta property="og:description" content="<%= typeof description !== 'undefined' && description ? description : 'Put money behind the debate you want to see.' %>">
<meta property="og:url" content="<%= baseUrl + path %>">
<meta property="og:type" content="website">
<% if (typeof ogImage !== 'undefined' && ogImage) { %>
<meta property="og:image" content="<%= ogImage %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="<%= ogImage %>">
<% } else { %>
<meta name="twitter:card" content="summary">
<% } %>
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="brand" href="/"><i></i>THROWDOWN</a>
    <nav class="nav">
      <a href="/how" class="hide-sm">How it works</a>
      <a href="/new" class="btn btn-primary btn-sm">Propose a debate</a>
    </nav>
  </div>
</header>
